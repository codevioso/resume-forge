# Local development settings for the API (copy to api/.env).
# Production values are set in the repository root's .env; see docs/DEPLOY.md.

# The web app's origin. In development the Vite dev server proxies /api here.
PUBLIC_URL=http://localhost:5173

# Signs sessions and tokens. At least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64'))"
AUTH_SECRET=

# Laragon's MySQL, database "paperplane" (create it once: CREATE DATABASE paperplane;)
DATABASE_URL=mysql://root@127.0.0.1:3306/paperplane

# Laragon's Mailpit catches every email; read them at http://127.0.0.1:8025
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=Paperplane <no-reply@paperplane.local>

# Optional: Google sign-in (both or neither).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
