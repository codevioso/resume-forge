{
  "name": "paperplane-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "express": "5.3.0",
    "kysely": "0.29.6",
    "mysql2": "3.24.6",
    "nodemailer": "10.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.1",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
