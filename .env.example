# ─── Production (docker compose) ─────────────────────────────────────────────
# Copy to `.env` next to docker-compose.yml on the server. See docs/DEPLOY.md.

# The public hostname. Its DNS A/AAAA record must point at this server before
# the first `docker compose up`, or Caddy cannot obtain the TLS certificate.
DOMAIN=resume.example.com

# Let's Encrypt contacts this address about certificate problems.
ACME_EMAIL=you@example.com

# Signs session cookies and email links. Generate once and keep it: changing
# it signs everyone out.
#   openssl rand -base64 48
AUTH_SECRET=

# Database passwords. Letters and digits only (they go into a URL):
#   openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Email: needed for email-and-password accounts (verification, password reset)
# and emailed sign-in links. Any SMTP service works. Without these two, those
# sign-in methods are switched off and only Google sign-in is offered.
# Resend:   SMTP_URL=smtp://resend:<API_KEY>@smtp.resend.com:587
# Postmark: SMTP_URL=smtp://<SERVER_TOKEN>:<SERVER_TOKEN>@smtp.postmarkapp.com:587
# SMTP_URL=
# EMAIL_FROM=Paperplane <no-reply@resume.example.com>

# Google sign-in (both or neither). Authorized redirect URI in Google Cloud:
#   https://<DOMAIN>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional tuning. Defaults suit a 2 vCPU / 4 GB VPS.
# Saved resumes per account.
# MAX_RESUMES_PER_USER=50
# Days of nightly database backups kept in ./backups.
# BACKUP_KEEP_DAYS=14
# Free trial credits for every account that confirms its email, and how many
# days they last. TRIAL_CREDITS=0 switches the trial off.
# TRIAL_CREDITS=300
# TRIAL_DAYS=15
# AI features (docs/PLAN-2.0.md). Leave off until an Anthropic API key is set.
# AI_ENABLED=false
# AI actions one user may run per minute, and per day.
# AI_RATE_PER_MINUTE=10
# AI_DAILY_LIMIT=100
# Memory caps for the database and the pdf container.
# DB_MEMORY_LIMIT=768m
# PDF_MEMORY_LIMIT=1536m
# Exports rendered at the same time. Each needs ~250 MB of RAM.
# PDF_CONCURRENCY=2
# Exports one IP address may request per minute.
# PDF_RATE_LIMIT_PER_MINUTE=30
# How long an export may wait for a free slot before the user is told to retry.
# PDF_QUEUE_TIMEOUT_MS=20000
# Longest a single render may take.
# PDF_RENDER_TIMEOUT_MS=30000


# ─── Local development ───────────────────────────────────────────────────────
# The web app needs no env file: `npm run dev` proxies /api/pdf to the
# pdf-service on :3040 and the rest of /api to the API on :3050
# (vite.config.ts). The API has its own settings file: copy
# api/.env.example to api/.env. See docs/DEPLOY.md, "Local development".
#
# Only to point the app at a PDF service on a different origin, put this in
# `.env.local` (Vite reads VITE_-prefixed variables at build time):
# VITE_PDF_SERVICE_URL=https://pdf.example.com
# That service must then list the app's origin in its ALLOWED_ORIGINS.
